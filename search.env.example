# Optional additions to existing .env; defaults work without editing it.
# This template is not automatically loaded.
RAG_SEARCH_BASE_URL=http://127.0.0.1:59200
RAG_SEARCH_INDEX=paperlens-papers-v1
RAG_SEARCH_TIMEOUT_SECONDS=20
# Only Compose uses this port setting; if changing it, also change BASE_URL above.
RAG_SEARCH_PORT=59200
